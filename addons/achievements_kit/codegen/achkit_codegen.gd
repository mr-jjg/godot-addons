class_name AchKitCodegen
extends RefCounted

## Reads and writes a game's achievement definitions file, which is plain GDScript generated by
## the Achievements dock. Static, pure and headless: no editor references, so a game's checks
## and throwaway scripts can use it too.
##
## Reading compiles the text with Godot's own parser (GDScript.new(), source_code, reload(),
## get_script_constant_map()), so a tool sees exactly what the game's preload sees, with no
## resource cache and so no stale read after a write.
##
## Writing is byte-for-byte deterministic (serialize). A file is canonical when parsing it and
## serializing the result gives back the same text (is_canonical); a game's check fails on a
## file the dock would not have written.
##
## `model` (the dock's in-memory state) is {"achievements": {id: def}, "renamed": {old: id},
## "retired": Array[StringName]}. The model edits below are pure: they return a new model and
## leave the input untouched.

const HEADER_FIRST_LINE := "## GENERATED by the Achievements dock (addons/achievements_kit). DO NOT EDIT BY HAND:"
const DEFAULT_PREFIXES := {"earned": "ach_", "progress": "achp_"}


## Compile `text` and read its consts. -> {ok, error, schema: int, achievements: Dictionary,
## renamed: Dictionary, retired: Array[StringName]}. Dictionaries are mutable deep copies.
## A GDScript error, a missing SCHEMA or ACHIEVEMENTS, or a SCHEMA newer than this addon
## knows gives ok:false.
static func parse_text(text: String) -> Dictionary:
	var out := {"ok": false, "error": "", "schema": 0, "achievements": {}, "renamed": {},
		"retired": _sn_array([])}
	var consts := _compile_consts(text)
	if consts.has("error"):
		out.error = consts.error
		return out
	var c: Dictionary = consts.consts
	if not c.has("SCHEMA") or typeof(c["SCHEMA"]) != TYPE_INT:
		out.error = "no `const SCHEMA := <int>` in the definitions file"
		return out
	var schema: int = c["SCHEMA"]
	out.schema = schema
	if schema > AchKitSchema.SCHEMA_VERSION:
		out.error = ("definitions file SCHEMA %d is newer than this achievements_kit knows (%d): "
			+ "update achievements_kit") % [schema, AchKitSchema.SCHEMA_VERSION]
		return out
	if schema < 1:
		out.error = "definitions file SCHEMA %d is not a valid version" % schema
		return out
	if not c.has("ACHIEVEMENTS") or typeof(c["ACHIEVEMENTS"]) != TYPE_DICTIONARY:
		out.error = "no `const ACHIEVEMENTS := {...}` in the definitions file"
		return out
	if c.has("RENAMED") and typeof(c["RENAMED"]) != TYPE_DICTIONARY:
		out.error = "RENAMED must be a Dictionary"
		return out
	if c.has("RETIRED") and typeof(c["RETIRED"]) != TYPE_ARRAY:
		out.error = "RETIRED must be an Array"
		return out
	# Older schemas would be upgraded here, field by field (none yet: SCHEMA 1 is the first).
	out.achievements = (c["ACHIEVEMENTS"] as Dictionary).duplicate(true)
	out.renamed = (c.get("RENAMED", {}) as Dictionary).duplicate(true)
	out.retired = _sn_array(c.get("RETIRED", []))
	out.ok = true
	return out


## parse_text() on a file's contents, plus "text" (what was read).
static func parse_file(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {"ok": false, "error": "not found: %s" % path, "schema": 0, "achievements": {},
			"renamed": {}, "retired": _sn_array([]), "text": ""}
	var text := FileAccess.get_file_as_string(path)
	var out := parse_text(text)
	out["text"] = text
	return out


## Compile a kinds file's text and read its `const KINDS`. -> {ok, error, kinds: Dictionary}
static func parse_kinds_text(text: String) -> Dictionary:
	var out := {"ok": false, "error": "", "kinds": {}}
	var consts := _compile_consts(text)
	if consts.has("error"):
		out.error = consts.error
		return out
	var c: Dictionary = consts.consts
	if not c.has("KINDS") or typeof(c["KINDS"]) != TYPE_DICTIONARY:
		out.error = "no `const KINDS := {...}` in the kinds file"
		return out
	out.kinds = (c["KINDS"] as Dictionary).duplicate(true)
	out.ok = true
	return out


## parse_kinds_text() on a file's contents. -> {ok, error, kinds}
static func parse_kinds_file(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {"ok": false, "error": "not found: %s" % path, "kinds": {}}
	return parse_kinds_text(FileAccess.get_file_as_string(path))


## The canonical text of a definitions file. Every definition is normalized against its kind
## (AchKitSchema.normalize_def): all fields, fixed order, params in the kind's order.
## ACHIEVEMENTS keeps its insertion order (display order); RENAMED and RETIRED are sorted so the
## file never depends on edit history. `prefixes` = {"earned": ..., "progress": ...}, used in
## the header's save-key line.
static func serialize(achievements: Dictionary, renamed: Dictionary, retired: Array,
		kinds: Dictionary, prefixes: Dictionary) -> String:
	var earned_prefix := str(prefixes.get("earned", DEFAULT_PREFIXES.earned))
	var progress_prefix := str(prefixes.get("progress", DEFAULT_PREFIXES.progress))
	var L := PackedStringArray()
	L.append("extends RefCounted")
	L.append(HEADER_FIRST_LINE)
	L.append("## the dock rewrites this whole file on every save, and check_achievements fails on a")
	L.append("## file the dock would not have written. Open the \"Achievements\" bottom panel instead.")
	L.append("##")
	L.append("## Ids are save keys (%s<id>, %s<id>): renaming or deleting one" % [earned_prefix, progress_prefix])
	L.append("## in the dock records it in RENAMED / RETIRED below so no player loses what they earned.")
	L.append("")
	L.append("const SCHEMA := %d" % AchKitSchema.SCHEMA_VERSION)
	L.append("")
	if achievements.is_empty():
		L.append("const ACHIEVEMENTS := {}")
	else:
		L.append("const ACHIEVEMENTS := {")
		for id: Variant in achievements:
			var raw: Variant = achievements[id]
			var def_in: Dictionary = raw if typeof(raw) == TYPE_DICTIONARY else {}
			var kind_name := StringName(str(def_in.get("kind", "")))
			var kind: Dictionary = kinds[kind_name] if typeof(kinds.get(kind_name)) == TYPE_DICTIONARY else {}
			var d := AchKitSchema.normalize_def(def_in, kind)
			L.append("\t%s: {" % _sname_lit(str(id)))
			L.append("\t\t\"name\": %s," % _str_lit(d.name))
			L.append("\t\t\"description\": %s," % _str_lit(d.description))
			L.append("\t\t\"kind\": %s," % _sname_lit(str(d.kind)))
			L.append("\t\t\"target\": %d," % d.target)
			var params: Dictionary = d.params
			if params.is_empty():
				L.append("\t\t\"params\": {},")
			else:
				L.append("\t\t\"params\": {")
				for p: Variant in params:
					L.append("\t\t\t%s: %s," % [_str_lit(str(p)), _value_lit(params[p])])
				L.append("\t\t},")
			L.append("\t\t\"hidden\": %s," % ("true" if d.hidden else "false"))
			L.append("\t\t\"hint\": %s," % _str_lit(d.hint))
			L.append("\t\t\"icon\": %s," % _str_lit(d.icon))
			L.append("\t\t\"category\": %s," % _sname_lit(str(d.category)))
			L.append("\t},")
		L.append("}")
	L.append("")
	L.append("## Old id -> current id. Maintained by the dock; never edit by hand.")
	var old_ids: Array = renamed.keys().map(func(k: Variant) -> String: return str(k))
	old_ids.sort()
	if old_ids.is_empty():
		L.append("const RENAMED := {}")
	else:
		L.append("const RENAMED := {")
		for old: String in old_ids:
			var to: Variant = renamed[StringName(old)] if renamed.has(StringName(old)) else renamed.get(old)
			L.append("\t%s: %s," % [_sname_lit(old), _sname_lit(str(to))])
		L.append("}")
	L.append("")
	L.append("## Ids that were deleted after they may have shipped. Never reused.")
	var gone := {}
	for r: Variant in retired:
		gone[str(r)] = true
	var gone_ids: Array = gone.keys()
	gone_ids.sort()
	if gone_ids.is_empty():
		L.append("const RETIRED: Array[StringName] = []")
	else:
		L.append("const RETIRED: Array[StringName] = [")
		for r: String in gone_ids:
			L.append("\t%s," % _sname_lit(r))
		L.append("]")
	return "\n".join(L) + "\n"


## parse_text(text), then serialize(...) == text.
static func is_canonical(text: String, kinds: Dictionary, prefixes: Dictionary) -> bool:
	var parsed := parse_text(text)
	if not parsed.ok:
		return false
	return serialize(parsed.achievements, parsed.renamed, parsed.retired, kinds, prefixes) == text


# ---- pure model edits (used by the dock) ----------------------------------------------

## Rename `old_id` to `new_id`, keeping its position. Existing RENAMED entries that point at
## `old_id` are repointed to `new_id` (chains collapse), and an entry keyed by `new_id` (renaming
## back to a former id) is erased. Only when `shipped` (old_id was in the file on disk) does
## RENAMED gain `old_id -> new_id`. A no-op copy when old_id is missing, new_id is taken, or
## they're equal.
static func rename(model: Dictionary, old_id: StringName, new_id: StringName, shipped: bool) -> Dictionary:
	var m := _copy_model(model)
	var achs: Dictionary = m.achievements
	if old_id == new_id or not achs.has(old_id) or achs.has(new_id):
		return m
	var moved := {}
	for id: Variant in achs:
		if StringName(str(id)) == old_id:
			moved[new_id] = achs[id]
		else:
			moved[id] = achs[id]
	m.achievements = moved
	var renamed: Dictionary = m.renamed
	if shipped:
		renamed[old_id] = new_id
	for k: Variant in renamed.keys():
		if StringName(str(renamed[k])) == old_id:
			renamed[k] = new_id
	renamed.erase(new_id)
	return m


## Delete `id`. RENAMED entries that pointed at it are erased and their old ids retired (they
## may hold earned bools on players' devices). Only when `shipped` is `id` itself retired.
static func remove(model: Dictionary, id: StringName, shipped: bool) -> Dictionary:
	var m := _copy_model(model)
	var achs: Dictionary = m.achievements
	if not achs.has(id):
		return m
	achs.erase(id)
	var retired: Array[StringName] = m.retired
	if shipped and not retired.has(id):
		retired.append(id)
	var renamed: Dictionary = m.renamed
	for k: Variant in renamed.keys():
		if StringName(str(renamed[k])) == id:
			renamed.erase(k)
			var old := StringName(str(k))
			if not retired.has(old):
				retired.append(old)
	return m


## Move `id` by `delta` places in display order (clamped to the ends).
static func move(model: Dictionary, id: StringName, delta: int) -> Dictionary:
	var m := _copy_model(model)
	var achs: Dictionary = m.achievements
	if not achs.has(id):
		return m
	var order: Array = achs.keys()
	var at := order.find(id)
	var to := clampi(at + delta, 0, order.size() - 1)
	if to == at:
		return m
	order.remove_at(at)
	order.insert(to, id)
	var moved := {}
	for k: Variant in order:
		moved[k] = achs[k]
	m.achievements = moved
	return m


# ---- internals -------------------------------------------------------------------

## -> {consts: Dictionary} or {error: String}
static func _compile_consts(text: String) -> Dictionary:
	var script := GDScript.new()
	script.source_code = text
	var err := script.reload()
	if err != OK:
		return {"error": "GDScript error (%s): the file does not compile" % error_string(err)}
	var consts := {}
	var map := script.get_script_constant_map()
	for k: Variant in map:
		consts[str(k)] = map[k]
	return {"consts": consts}


static func _copy_model(model: Dictionary) -> Dictionary:
	return {
		"achievements": (model.get("achievements", {}) as Dictionary).duplicate(true),
		"renamed": (model.get("renamed", {}) as Dictionary).duplicate(true),
		"retired": _sn_array(model.get("retired", [])),
	}


static func _sn_array(a: Variant) -> Array[StringName]:
	var out: Array[StringName] = []
	if typeof(a) == TYPE_ARRAY:
		for v: Variant in a:
			out.append(StringName(str(v)))
	return out


## A GDScript String literal. Escapes \, ", newline, tab and carriage return (a raw CR or LF
## would end the literal); everything else is written verbatim (UTF-8).
static func _str_lit(s: String) -> String:
	return "\"%s\"" % (s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")
		.replace("\t", "\\t").replace("\r", "\\r"))


static func _sname_lit(s: String) -> String:
	return "&" + _str_lit(s)


static func _value_lit(v: Variant) -> String:
	match typeof(v):
		TYPE_STRING, TYPE_STRING_NAME:
			return _str_lit(str(v))
		TYPE_BOOL:
			return "true" if v else "false"
		TYPE_INT:
			return str(v)
	return var_to_str(v)
