extends "res://tests/achievements_kit/achkit_test_case.gd"

## AchKitCodegen: serialize/parse round trip, determinism, field order, header, canonical
## checks, error cases, and the pure rename/remove/move model edits.

const Kinds := preload("res://tests/achievements_kit/fixtures/kinds.gd")
const PREFIXES := {"earned": "sax_prog_ach_", "progress": "sax_prog_achp_"}
const FIXTURE_DEFS := "res://tests/achievements_kit/fixtures/achievements.gd"
const FIXTURE_KINDS := "res://tests/achievements_kit/fixtures/kinds.gd"
const FIXTURE_PREFIXES := {"earned": "test_ach_", "progress": "test_achp_"}

## The spec's example file (§4.2), byte for byte.
const SPEC_EXAMPLE := """extends RefCounted
## GENERATED by the Achievements dock (addons/achievements_kit). DO NOT EDIT BY HAND:
## the dock rewrites this whole file on every save, and check_achievements fails on a
## file the dock would not have written. Open the "Achievements" bottom panel instead.
##
## Ids are save keys (sax_prog_ach_<id>, sax_prog_achp_<id>): renaming or deleting one
## in the dock records it in RENAMED / RETIRED below so no player loses what they earned.

const SCHEMA := 1

const ACHIEVEMENTS := {
	&"first_clear": {
		"name": "Clean Sweep",
		"description": "Clear the board.",
		"kind": &"boards_cleared",
		"target": 1,
		"params": {},
		"hidden": false,
		"hint": "",
		"icon": "",
		"category": &"",
	},
}

## Old id -> current id. Maintained by the dock; never edit by hand.
const RENAMED := {}

## Ids that were deleted after they may have shipped. Never reused.
const RETIRED: Array[StringName] = []
"""


func _tricky() -> Dictionary:
	return {
		&"quotes": {"name": "Say \"hi\"", "description": "back\\slash\nnew line\ttab", "kind": &"boards_cleared",
			"target": 3, "params": {}, "hidden": false, "hint": "", "icon": "", "category": &"c\"q"},
		&"unicode": {"name": "Étoile ✓ 日本", "description": "Ünïcödé — “curly” 🎯", "kind": &"round_reached",
			"target": 50, "params": {"source": "quick_play"}, "hidden": true, "hint": "Look\\up \"there\"",
			"icon": "", "category": &"runs"},
		&"flags_all": {"name": "Flags", "description": "Every param type.", "kind": &"flags", "target": 2,
			"params": {"hard": true, "tag": "x y", "level": 7}, "hidden": false, "hint": "", "icon": "",
			"category": &""},
	}


func _model() -> Dictionary:
	return {"achievements": _tricky(), "renamed": {&"old_q": &"quotes"}, "retired": [&"zz_gone", &"aa_gone"]}


func _ser(m: Dictionary) -> String:
	return AchKitCodegen.serialize(m.achievements, m.renamed, m.retired, Kinds.KINDS, PREFIXES)


func test_spec_example_byte_for_byte() -> void:
	var achs := {&"first_clear": {"name": "Clean Sweep", "description": "Clear the board.",
		"kind": &"boards_cleared", "target": 1}}
	var text := AchKitCodegen.serialize(achs, {}, [], Kinds.KINDS, PREFIXES)
	check_eq(text, SPEC_EXAMPLE, "spec example")
	check(AchKitCodegen.is_canonical(SPEC_EXAMPLE, Kinds.KINDS, PREFIXES), "spec example is canonical")


func test_round_trip() -> void:
	var m := _model()
	var text := _ser(m)
	var parsed := AchKitCodegen.parse_text(text)
	check(parsed.ok, "parses: %s" % parsed.error)
	check_eq(parsed.schema, 1, "schema")
	var achs: Dictionary = parsed.achievements
	check_eq(achs.keys(), [&"quotes", &"unicode", &"flags_all"], "ids in order")
	for id: StringName in m.achievements:
		var want := AchKitSchema.normalize_def(m.achievements[id], Kinds.KINDS[m.achievements[id].kind])
		check_eq(achs.get(id), want, "%s round-trips" % id)
	check_eq(achs[&"quotes"].name, "Say \"hi\"", "quotes survive")
	check_eq(achs[&"quotes"].description, "back\\slash\nnew line\ttab", "backslash, newline, tab survive")
	check_eq(achs[&"unicode"].name, "Étoile ✓ 日本", "unicode survives")
	check_eq(achs[&"quotes"].category, &"c\"q", "escaped StringName survives")
	check_eq(typeof(achs.keys()[0]), TYPE_STRING_NAME, "ids are StringNames")
	check_eq(typeof(achs[&"quotes"].kind), TYPE_STRING_NAME, "kind is a StringName")
	check_eq(typeof(achs[&"quotes"].category), TYPE_STRING_NAME, "category is a StringName")
	check_eq(typeof(achs[&"quotes"].name), TYPE_STRING, "name is a String")
	check_eq(achs[&"flags_all"].params, {"tag": "x y", "level": 7, "hard": true}, "params typed, kind order")
	check_eq(achs[&"flags_all"].params.keys(), ["tag", "level", "hard"], "params in kind order")
	check_eq(parsed.renamed, {&"old_q": &"quotes"}, "renamed")
	check_eq(typeof(parsed.renamed.values()[0]), TYPE_STRING_NAME, "renamed values are StringNames")
	check_eq(parsed.retired, [&"aa_gone", &"zz_gone"] as Array[StringName], "retired sorted")
	check_eq(parsed.retired.get_typed_builtin(), TYPE_STRING_NAME, "retired is Array[StringName]")
	check(not (parsed.achievements as Dictionary).is_read_only(), "parsed dicts are mutable")


func test_serialize_is_deterministic() -> void:
	var a := _ser(_model())
	var b := _ser(_model())
	check_eq(a, b, "same bytes twice")
	var parsed := AchKitCodegen.parse_text(a)
	check_eq(AchKitCodegen.serialize(parsed.achievements, parsed.renamed, parsed.retired, Kinds.KINDS, PREFIXES), a,
		"parse -> serialize is a fixed point")
	check(AchKitCodegen.is_canonical(a, Kinds.KINDS, PREFIXES), "is_canonical")
	# RENAMED / RETIRED order never depends on edit history.
	var m := _model()
	m.renamed = {&"zz": &"quotes", &"aa": &"unicode"}
	var m2 := _model()
	m2.renamed = {&"aa": &"unicode", &"zz": &"quotes"}
	m2.retired = [&"aa_gone", &"zz_gone", &"aa_gone"]
	check_eq(_ser(m), _ser(m2), "renamed/retired sorted and deduped")


func test_field_order_and_format() -> void:
	var text := _ser(_model())
	var block := text.substr(text.find("&\"flags_all\": {"))
	var last := -1
	for f: String in AchKitSchema.FIELDS:
		var at := block.find("\"%s\":" % f)
		check(at > last, "field %s after the previous one" % f)
		last = at
	check(block.find("\"tag\":") < block.find("\"level\":") and block.find("\"level\":") < block.find("\"hard\":"),
		"params in kind order")
	check(not text.contains("    "), "tabs, never spaces")
	check(not text.contains("\r"), "LF only")
	check(text.ends_with("]\n") and not text.ends_with("\n\n"), "one final newline")
	check(text.contains("\t\t\"params\": {\n\t\t\t\"source\": \"quick_play\",\n\t\t},\n"), "one param per line")
	check(text.contains("\t\t\"hidden\": true,\n"), "bool literal")
	check(text.contains("\t\t\"target\": 50,\n"), "int literal")
	check(text.contains("\t\t\"name\": \"Say \\\"hi\\\"\",\n"), "escaped quote")
	check(text.contains("\"back\\\\slash\\nnew line\\ttab\""), "escaped backslash, newline, tab")
	check(text.contains("\"Étoile ✓ 日本\""), "unicode verbatim")
	check(text.contains("const RETIRED: Array[StringName] = [\n\t&\"aa_gone\",\n\t&\"zz_gone\",\n]\n"), "retired")
	check(text.contains("const RENAMED := {\n\t&\"old_q\": &\"quotes\",\n}\n"), "renamed")


func test_header() -> void:
	var text := _ser(_model())
	check(text.begins_with("extends RefCounted\n" + AchKitCodegen.HEADER_FIRST_LINE + "\n"), "fixed first lines")
	check(text.contains("## Ids are save keys (sax_prog_ach_<id>, sax_prog_achp_<id>): renaming or deleting one\n"),
		"save-key line uses the prefixes")
	var other := AchKitCodegen.serialize({}, {}, [], Kinds.KINDS, {"earned": "x_", "progress": "y_"})
	check(other.contains("## Ids are save keys (x_<id>, y_<id>)"), "other prefixes")
	check(other.contains("\nconst ACHIEVEMENTS := {}\n"), "empty ACHIEVEMENTS")
	check(AchKitCodegen.parse_text(other).ok, "empty file parses")
	check(not AchKitCodegen.is_canonical(other, Kinds.KINDS, PREFIXES), "header prefixes are part of canonical")


func test_hand_edited_is_not_canonical() -> void:
	var text := _ser(_model())
	check(AchKitCodegen.is_canonical(text, Kinds.KINDS, PREFIXES), "canonical to start")
	var lines := text.split("\n")
	var i := lines.find("\t\t\"name\": \"Flags\",")
	check(i > 0, "found the name line")
	var swapped := lines.duplicate()
	swapped[i] = lines[i + 1]
	swapped[i + 1] = lines[i]
	var reordered := "\n".join(swapped)
	check(AchKitCodegen.parse_text(reordered).ok, "reordered still parses")
	check(not AchKitCodegen.is_canonical(reordered, Kinds.KINDS, PREFIXES), "reordered fields not canonical")
	check(not AchKitCodegen.is_canonical(text.replace("\t\"", "    \""), Kinds.KINDS, PREFIXES), "spaces")
	check(not AchKitCodegen.is_canonical(text + "\n", Kinds.KINDS, PREFIXES), "extra blank line")
	check(not AchKitCodegen.is_canonical(text.replace("\n", "\r\n"), Kinds.KINDS, PREFIXES), "CRLF")
	var missing_field := text.replace("\t\t\"icon\": \"\",\n", "")
	check(AchKitCodegen.parse_text(missing_field).ok, "missing field parses")
	check(not AchKitCodegen.is_canonical(missing_field, Kinds.KINDS, PREFIXES), "missing field not canonical")


func test_parse_errors() -> void:
	var bad := AchKitCodegen.parse_text("extends RefCounted\nconst ACHIEVEMENTS := {\n")
	check(not bad.ok, "syntax error -> ok false")
	check(str(bad.error) != "", "syntax error has a message")
	check(not AchKitCodegen.is_canonical("extends RefCounted\nconst ACHIEVEMENTS := {\n", Kinds.KINDS, PREFIXES),
		"syntax error not canonical")
	var newer := AchKitCodegen.parse_text(SPEC_EXAMPLE.replace("const SCHEMA := 1", "const SCHEMA := 2"))
	check(not newer.ok, "newer SCHEMA refused")
	check(str(newer.error).contains("update achievements_kit"), "says to update: %s" % newer.error)
	var no_schema := AchKitCodegen.parse_text("extends RefCounted\nconst ACHIEVEMENTS := {}\n")
	check(not no_schema.ok and str(no_schema.error).contains("SCHEMA"), "missing SCHEMA")
	var no_achs := AchKitCodegen.parse_text("extends RefCounted\nconst SCHEMA := 1\n")
	check(not no_achs.ok and str(no_achs.error).contains("ACHIEVEMENTS"), "missing ACHIEVEMENTS")
	var minimal := AchKitCodegen.parse_text("extends RefCounted\nconst SCHEMA := 1\nconst ACHIEVEMENTS := {}\n")
	check(minimal.ok, "RENAMED / RETIRED optional")
	check_eq(minimal.renamed, {}, "renamed defaults empty")


func test_files() -> void:
	var parsed := AchKitCodegen.parse_file(FIXTURE_DEFS)
	check(parsed.ok, "fixture parses: %s" % parsed.error)
	check_eq(parsed.achievements.keys(), [&"first_clear", &"round_10_quick", &"secret"], "fixture ids")
	check(AchKitCodegen.is_canonical(parsed.text, Kinds.KINDS, FIXTURE_PREFIXES), "fixture is canonical")
	check_eq(parsed.renamed, {&"old_clear": &"first_clear"}, "fixture renamed")
	var kinds := AchKitCodegen.parse_kinds_file(FIXTURE_KINDS)
	check(kinds.ok, "kinds fixture parses")
	check_eq(kinds.kinds, Kinds.KINDS, "kinds equal the preload")
	check(not AchKitCodegen.parse_file("res://tests/achievements_kit/fixtures/missing.gd").ok, "missing file")
	check(not AchKitCodegen.parse_kinds_file("res://nope.gd").ok, "missing kinds file")
	check(not AchKitCodegen.parse_kinds_text("extends RefCounted\nconst X := 1\n").ok, "no KINDS")


func test_rename() -> void:
	var m := {"achievements": {&"a": {"name": "A"}, &"b": {"name": "B"}, &"c": {"name": "C"}},
		"renamed": {&"old": &"b"}, "retired": [] as Array[StringName]}
	var before := var_to_str(m)
	var r := AchKitCodegen.rename(m, &"b", &"b2", true)
	check_eq(var_to_str(m), before, "input untouched")
	check_eq(r.achievements.keys(), [&"a", &"b2", &"c"], "position kept")
	check_eq(r.achievements[&"b2"], {"name": "B"}, "entry moved")
	check_eq(r.renamed, {&"old": &"b2", &"b": &"b2"}, "shipped: recorded, chain collapsed")
	var back := AchKitCodegen.rename(r, &"b2", &"b", false)
	check_eq(back.renamed, {&"old": &"b"}, "rename back erases the self entry and repoints")
	var r2 := AchKitCodegen.rename(m, &"b", &"b2", false)
	check_eq(r2.renamed, {&"old": &"b2"}, "not shipped: no new entry, existing ones still repointed")
	var back2 := AchKitCodegen.rename(r, &"b2", &"b", true)
	check_eq(back2.renamed, {&"old": &"b", &"b2": &"b"}, "shipped rename back")
	check(AchKitSchema.validate_renamed(back2.achievements, back2.renamed).is_empty(), "no dangling or cycle")
	var noop := AchKitCodegen.rename(m, &"b", &"c", true)
	check_eq(noop.achievements.keys(), [&"a", &"b", &"c"], "rename onto a taken id is a no-op")
	check_eq(AchKitCodegen.rename(m, &"zz", &"y", true).renamed, {&"old": &"b"}, "unknown id no-op")


func test_remove() -> void:
	var m := {"achievements": {&"a": {"name": "A"}, &"b": {"name": "B"}},
		"renamed": {&"old_b": &"b", &"old_a": &"a"}, "retired": [&"x"] as Array[StringName]}
	var before := var_to_str(m)
	var r := AchKitCodegen.remove(m, &"b", true)
	check_eq(var_to_str(m), before, "input untouched")
	check_eq(r.achievements.keys(), [&"a"], "entry gone")
	check_eq(r.retired, [&"x", &"b", &"old_b"] as Array[StringName], "shipped id and its old ids retired")
	check_eq(r.renamed, {&"old_a": &"a"}, "renames into it erased")
	var r2 := AchKitCodegen.remove(m, &"b", false)
	check_eq(r2.retired, [&"x", &"old_b"] as Array[StringName], "not shipped: only its old ids retired")
	check_eq(r2.renamed, {&"old_a": &"a"}, "not shipped: renames into it still erased")
	check(AchKitSchema.validate_renamed(r2.achievements, r2.renamed).is_empty(), "nothing dangling")


func test_move() -> void:
	var m := {"achievements": {&"a": {}, &"b": {}, &"c": {}}, "renamed": {}, "retired": []}
	check_eq(AchKitCodegen.move(m, &"c", -1).achievements.keys(), [&"a", &"c", &"b"], "up one")
	check_eq(AchKitCodegen.move(m, &"a", 1).achievements.keys(), [&"b", &"a", &"c"], "down one")
	check_eq(AchKitCodegen.move(m, &"a", -5).achievements.keys(), [&"a", &"b", &"c"], "clamped at top")
	check_eq(AchKitCodegen.move(m, &"a", 9).achievements.keys(), [&"b", &"c", &"a"], "clamped at bottom")
	check_eq(m.achievements.keys(), [&"a", &"b", &"c"], "input untouched")
